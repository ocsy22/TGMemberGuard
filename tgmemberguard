#!/usr/bin/env bash
set -euo pipefail
if [[ ${EUID} -ne 0 ]]; then
    echo '请使用 sudo tgmemberguard ...' >&2
    exit 1
fi
case "${1:-}" in
    init|target-add|target-remove|source-set|mode|web-bind)
        exec /opt/tgmemberguard/.venv/bin/python /opt/tgmemberguard/server.py "$@"
        ;;
    *)
        exec runuser -u tgmemberguard -- /opt/tgmemberguard/.venv/bin/python /opt/tgmemberguard/server.py "$@"
        ;;
esac
